# Synthetic local demo only. Set a persistent random key before using sessions.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Used only by manage.py seed_demo_users. Set your own local passwords.
DEMO_COORDINATOR_PASSWORD=
DEMO_REVIEWER_PASSWORD=
# Leave DATABASE_URL unset for backend/db.sqlite3.
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/healthmesh
